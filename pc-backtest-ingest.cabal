cabal-version:      3.0
name:               pc-backtest-ingest
version:            0.1.0.0
-- synopsis:
-- description:
license:            GPL-3.0-or-later
license-file:       LICENSE
author:             marshmallow
maintainer:         git@althaea.zone
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable pc-backtest-ingest
    import:           warnings
    main-is:          Main.hs
    other-modules:
            Vlr
            Polymarket
            Domain.Types
            Capabilities.Polymarket
    -- other-extensions:
    build-depends:
            http-conduit ^>=2.3.9.1,
            transformers ^>=0.6.1.1,
            time ^>=1.12.2,
            text ^>=2.1.3,
            base ^>=4.20.2.0,
            scalpel ^>=0.6.2.2,
            HTTP ^>=4000.5.0,
            modern-uri ^>=0.3.6.1,
            lens ^>=5.3.6,
            aeson ^>=2.2.3.0,
            bluefin ^>=0.0.4.3,
            safe-exceptions ^>=0.1.7.4,
            bytestring ^>=0.12.2.0,
            fast-logger ^>=3.2.8
    hs-source-dirs:   app
    default-language: GHC2024
    default-extensions: OverloadedStrings QuasiQuotes DeriveGeneric DuplicateRecordFields
